{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "allowJs": true,
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "preserve",
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["src/**/*", "build/**/*"],
    "exclude": ["node_modules"],
    "ts-node": {
        "esm": false,
        "compilerOptions": {
            "module": "CommonJS"
        }
    }
}
